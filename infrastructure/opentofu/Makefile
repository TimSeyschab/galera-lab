TOFU ?= tofu
TFVARS := terraform.tfvars
SSH_KEY_NAME ?= hetzner-galera-lab (laptop)
ADMIN_IP_URL ?= https://api.ipify.org

.PHONY: tofu-tfvars tofu-fmt tofu-init tofu-validate tofu-plan plan-destroy apply destroy tofu-check tflint

tofu-tfvars:
	@set -eu; \
	if [ -f "$(TFVARS)" ]; then \
		echo "$(TFVARS) already exists; not overwriting"; \
		echo "Remove it first if you want to refresh admin_cidr."; \
		exit 0; \
	fi; \
	admin_ip="$$(curl -fsSL "$(ADMIN_IP_URL)")"; \
	case "$$admin_ip" in \
		""|*[!0-9.]*) echo "Could not determine a valid public IPv4 from $(ADMIN_IP_URL)" >&2; exit 1 ;; \
	esac; \
	{ \
		echo "# Generated by make tofu-tfvars. Do not commit."; \
		echo; \
		echo "ssh_key_name = \"$(SSH_KEY_NAME)\""; \
		echo "admin_cidr   = \"$$admin_ip/32\""; \
	} > "$(TFVARS)"; \
	chmod 600 "$(TFVARS)"; \
	echo "Created $(TFVARS) with SSH key '$(SSH_KEY_NAME)' and current public IPv4 /32."

tofu-fmt:
	$(TOFU) fmt -check -recursive

tofu-init:
	$(TOFU) init -backend=false

tofu-validate:
	$(TOFU) validate

tofu-plan: tofu-tfvars tofu-init tofu-validate
	$(TOFU) plan

plan-destroy: tofu-tfvars tofu-init tofu-validate
	$(TOFU) plan -destroy

apply: tofu-tfvars tofu-init tofu-validate
	$(TOFU) apply

destroy: tofu-tfvars tofu-init tofu-validate
	$(TOFU) destroy

tflint:
	@if command -v ~/go/bin/tflint >/dev/null 2>&1; then \
		~/go/bin/tflint --chdir=.; \
	else \
		echo "tflint not installed; skipping optional check"; \
	fi

tofu-check: tofu-fmt tofu-init tofu-validate tflint
