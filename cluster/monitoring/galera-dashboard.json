{
  "annotations": {"list": []},
  "editable": false,
  "graphTooltip": 1,
  "panels": [
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"decimals": 0, "unit": "short"}, "overrides": []},
      "gridPos": {"h": 6, "w": 6, "x": 0, "y": 0},
      "id": 1,
      "options": {"colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto"},
      "targets": [{"expr": "max(mysql_global_status_wsrep_cluster_size)", "refId": "A"}],
      "title": "Galera Cluster Size",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"decimals": 0, "max": 1, "min": 0, "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}, "unit": "none"}, "overrides": []},
      "gridPos": {"h": 6, "w": 6, "x": 6, "y": 0},
      "id": 2,
      "options": {"colorMode": "background", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": {"calcs": ["min"], "fields": "", "values": false}, "textMode": "auto"},
      "targets": [{"expr": "min(mysql_global_status_wsrep_ready)", "refId": "A"}],
      "title": "Galera Ready",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"decimals": 2, "unit": "percent"}, "overrides": []},
      "gridPos": {"h": 6, "w": 6, "x": 12, "y": 0},
      "id": 3,
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}},
      "targets": [{"expr": "100 * sum(mysql_global_status_wsrep_flow_control_paused) / clamp_min(count(mysql_global_status_wsrep_flow_control_paused), 1)", "refId": "A"}],
      "title": "Galera Flow Control Paused",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"decimals": 0, "unit": "short"}, "overrides": []},
      "gridPos": {"h": 6, "w": 6, "x": 18, "y": 0},
      "id": 4,
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}},
      "targets": [{"expr": "sum by (instance) (mysql_global_status_wsrep_local_recv_queue)", "refId": "A"}, {"expr": "sum by (instance) (mysql_global_status_wsrep_local_send_queue)", "refId": "B"}],
      "title": "Galera Replication Queues",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"decimals": 1, "unit": "percent"}, "overrides": []},
      "gridPos": {"h": 7, "w": 8, "x": 0, "y": 6},
      "id": 5,
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}},
      "targets": [{"expr": "100 * sum(mysql_global_status_innodb_buffer_pool_bytes_data) / clamp_min(sum(mysql_global_variables_innodb_buffer_pool_size), 1)", "refId": "A"}],
      "title": "InnoDB Buffer Pool Utilization",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"decimals": 2, "unit": "percent"}, "overrides": []},
      "gridPos": {"h": 7, "w": 8, "x": 8, "y": 6},
      "id": 6,
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}},
      "targets": [{"expr": "100 * (1 - sum(rate(mysql_global_status_innodb_buffer_pool_reads[5m])) / clamp_min(sum(rate(mysql_global_status_innodb_buffer_pool_read_requests[5m])), 1))", "refId": "A"}],
      "title": "InnoDB Buffer Pool Hit Rate",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"decimals": 0, "unit": "short"}, "overrides": []},
      "gridPos": {"h": 7, "w": 8, "x": 16, "y": 6},
      "id": 7,
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}},
      "targets": [{"expr": "sum(mysql_global_status_threads_connected)", "refId": "A"}, {"expr": "sum(rate(mysql_global_status_questions[5m]))", "refId": "B"}],
      "title": "Connections and Queries",
      "type": "timeseries"
    }
  ],
